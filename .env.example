# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/marketing

# AES-256-GCM key for sealing provider credentials at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Google service account (GA4 + Search Console).
# Create in Google Cloud, enable the Analytics Data API and Search Console API,
# then grant the service-account email read access on the GA4 property and the
# Search Console property.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
